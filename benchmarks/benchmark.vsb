-- Vesbo L2/L3/L4 Core Runtime Benchmark

global var global_counter is 0

struct Vec2
    var x is 0
    var y is 0

    fnc add_in_place(dx, dy)
        self.x = self.x + dx
        self.y = self.y + dy
        return self.x + self.y

fnc sum_depth(n)
    if n <= 0
        return 0
    return 1 + sum_depth(n - 1)

fnc counter_gen(limit)
    var i is 1
    loop while i <= limit
        yield i
        i = i + 1
    return 0

fnc main()
    var t0 is clock()

    -- 1. Slot-indexed global variable benchmark
    var i is 0
    loop while i < 5000
        global_counter = global_counter + 1
        i = i + 1
    output "global_counter: " + string(global_counter)

    -- 2. Hashed map with interned string keys benchmark
    var table is {}
    var k is 0
    loop while k < 500
        var key is "key_" + string(k)
        table[key] = k * 2
        k = k + 1

    var map_sum is 0
    k = 0
    loop while k < 500
        var key is "key_" + string(k)
        map_sum = map_sum + table[key]
        k = k + 1
    output "map_sum: " + string(map_sum)

    -- 3. Deep recursion on growable VM stack (> 256 frames)
    var depth_res is sum_depth(400)
    output "depth_res: " + string(depth_res)

    -- 4. Struct field access and method dispatch benchmark
    var v is Vec2(10, 20)
    var m is 0
    var s_acc is 0
    loop while m < 1000
        s_acc = v.add_in_place(1, 2)
        m = m + 1
    output "struct_acc: " + string(s_acc)

    -- 5. Coroutine yield/resume benchmark
    var co is coroutine(counter_gen, 100)
    var co_sum is 0
    loop while is_alive(co)
        co_sum = co_sum + resume(co)
    output "co_sum: " + string(co_sum)

    var elapsed is clock() - t0
    var stats is gc_stats()
    output "instructions > 0: " + string(stats["instructions"] > 0)
    output "benchmark complete"
